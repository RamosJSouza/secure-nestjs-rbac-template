# Application
NODE_ENV=development
APP_NAME=admin-rbac-system

# Server (runtime uses PORT)
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_SSL=false
DB_SSL_CA=     # PEM-encoded CA cert (required in production when DB_SSL=true)

# Redis (optional in dev — enables shared cache and async audit via BullMQ when set)
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth - JWT RS256 (PRIVATE_KEY assina, PUBLIC_KEY verifica)
# Gerar par de chaves:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Para .env: cole o conteúdo PEM em uma única linha, substituindo quebras por \n
# OBRIGATÓRIO em TODOS os ambientes (falha rápida no boot se vazio).
PRIVATE_KEY=     # PEM RSA private key (required in ALL environments)
PUBLIC_KEY=      # PEM RSA public key (required in ALL environments)

# CORS (obrigatório em produção: URLs separadas por vírgula)
# Ex: ALLOWED_ORIGINS=https://admin.example.com,https://app.example.com
ALLOWED_ORIGINS=

# Resend (opcional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
